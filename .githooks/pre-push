#!/usr/bin/env bash
# What CI would tell you in eight minutes, told here in two seconds.
#
# Not the build (minutes), not scripts/mcp-smoke.ts (its preflight can run
# `bun install`, which a hook has no business doing), and not
# scripts/db-portability.mjs (it needs a database that already has a schema, and
# without CLAUDE_TASKS_DB it opens the real one).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

run=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  # An all-zero local sha is a branch deletion: nothing is being pushed.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  case "$remote_ref" in refs/tags/*) continue ;; esac
  if [ "$remote_ref" = "refs/heads/main" ] && [ "${ALLOW_PUSH_MAIN:-0}" != "1" ]; then
    echo "pre-push: main takes pull requests, not pushes." >&2
    echo "          git switch -c <type>/<kebab-case> && gh pr create" >&2
    echo "          ALLOW_PUSH_MAIN=1 git push   if you are bootstrapping." >&2
    exit 1
  fi
  run=1
done
[ "$run" -eq 1 ] || exit 0

command -v bun >/dev/null 2>&1 || { echo "pre-push: no bun on PATH; skipped."; exit 0; }

scratch=$(mktemp -d "${TMPDIR:-/tmp}/todos-push.XXXXXX")
trap 'rm -rf "$scratch"' EXIT
export CLAUDE_TASKS_DB="$scratch/tasks.db"
export XDG_STATE_HOME="$scratch/state"

bun run typecheck
bun test
bun run lint:messages
